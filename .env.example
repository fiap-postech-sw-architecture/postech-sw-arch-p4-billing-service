# Variaveis do Billing Service com valores de DEMONSTRACAO (os padroes do
# docker-compose.yml). No compose: `cp .env.example .env` e ajuste (o compose
# le o .env sozinho). Fora dele: `set -a; . ./.env; set +a; make run`. Em
# ambiente exposto tudo entra por Secret; os valores de demonstracao abaixo
# sao recusados com ENVIRONMENT=production.

# development | test | production. Sem a variavel o servico assume production
# (falha fechada): enderecos e segredo precisam vir explicitos.
ENVIRONMENT=development

# MongoDB do proprio servico, em replica set (transacoes). O do compose fica
# publicado em 127.0.0.1:27017.
MONGODB_URI=mongodb://127.0.0.1:27017/?directConnection=true
MONGODB_DB=billing

# JWKS do OS Service (chave publica dos JWT; http aceito, chamada interna).
JWKS_URL=http://127.0.0.1:8000/.well-known/jwks.json
JWT_ISSUER=pytstop-os-service
JWT_AUDIENCE=pytstop

# Base publica do Billing: entra no link de decisao enviado ao cliente e no
# checkout simulado (https fora de development/test).
BILLING_PUBLIC_URL=http://localhost:8002
# Segredo HMAC do link de decisao e do checkout simulado (>= 32 bytes fora de
# development/test; gere com `openssl rand -hex 32`).
ORCAMENTO_LINK_SECRET=demo-link-orcamento-pytstop-nao-usar-em-producao  # gitleaks:allow (valor de demonstracao)

# Prazos de decisao do orcamento e de pagamento da cobranca, e quantas recusas
# do provedor encerram a cobranca como RECUSADO.
ORCAMENTO_VALIDADE_HORAS=72
PAGAMENTO_VALIDADE_MINUTOS=60
PAGAMENTO_MAX_RECUSAS=3

# Pagamento: simulado (sem provedor; em production so com
# SIMULADOR_PERMITIDO=true) ou mercadopago (Checkout Pro real, exige o token e
# o segredo do webhook do painel do Mercado Pago).
MP_MODE=simulado
SIMULADOR_PERMITIDO=false
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
MP_API_URL=https://api.mercadopago.com
# Padrao: ${BILLING_PUBLIC_URL}/api/v1/webhooks/mercadopago (https fora de dev).
MP_NOTIFICATION_URL=
MP_TIMEOUT_SEGUNDOS=5

# Processo prazos: intervalo do ciclo (conciliacao com o Mercado Pago e
# expiracao), arquivo de heartbeat (healthcheck) e porta do /metrics.
PRAZOS_INTERVALO_SEGUNDOS=30
PRAZOS_HEARTBEAT=/tmp/prazos-heartbeat
METRICS_PORT=8000

# entrypoint.sh da imagem: seed da tabela de precos de demonstracao no boot da
# API (o compose liga).
RUN_SEED_ON_STARTUP=false

# So do compose: portas no host (127.0.0.1) e nome da imagem.
API_PORT=8002
MONGO_PORT=27017
BILLING_IMAGE=pytstop-billing:dev
