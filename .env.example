# Variaveis do Billing Service com valores de DEMONSTRACAO. Em ambiente exposto
# tudo entra por Secret; os valores de demonstracao abaixo sao recusados com
# ENVIRONMENT=production.
#
# No compose: `cp .env.example .env` (o compose le o .env sozinho) e ajuste o
# primeiro bloco: so ele chega aos containers. Fora do compose (`make run`):
# `set -a; . ./.env; set +a`, com o JWKS_URL do comentario e o segundo bloco.

# --- Repassadas pelo compose aos containers (e lidas pelo make run) ---------

# Base publica do Billing: entra no link de decisao enviado ao cliente e no
# checkout simulado (https fora de development/test).
BILLING_PUBLIC_URL=http://localhost:8002
# JWKS do OS Service (chave publica dos JWT; http aceito, chamada interna). No
# compose o OS roda no host; no make run use http://localhost:8000/.well-known/jwks.json.
# Emissor e audiencia do token sao fixos (iss=pytstop-os-service, aud=pytstop).
JWKS_URL=http://host.docker.internal:8000/.well-known/jwks.json
# Segredo HMAC do link de decisao e do checkout simulado (>= 32 bytes fora de
# development/test; gere com `openssl rand -hex 32`).
ORCAMENTO_LINK_SECRET=demo-link-orcamento-pytstop-nao-usar-em-producao  # gitleaks:allow (valor de demonstracao)
# Prazo de decisao do orcamento e de pagamento da cobranca, e quantas recusas
# do provedor encerram a cobranca como RECUSADO.
ORCAMENTO_VALIDADE_HORAS=72
PAGAMENTO_VALIDADE_MINUTOS=60
PAGAMENTO_MAX_RECUSAS=3
# Pagamento: simulado (sem provedor) ou mercadopago (Checkout Pro real, exige o
# token e o segredo do webhook do painel do Mercado Pago).
MP_MODE=simulado
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
MP_API_URL=https://api.mercadopago.com
# Vazio: <BILLING_PUBLIC_URL>/api/v1/webhooks/mercadopago (https fora de dev).
MP_NOTIFICATION_URL=
MP_TIMEOUT_SEGUNDOS=5
# Processo prazos: intervalo do ciclo (conciliacao e expiracao).
PRAZOS_INTERVALO_SEGUNDOS=30

# --- So fora do compose (make run, Kubernetes): o compose fixa estes ------

# development | test | production. Sem a variavel o servico assume production
# (falha fechada): enderecos e segredo precisam vir explicitos.
ENVIRONMENT=development
# MongoDB em replica set (transacoes); o do compose fica em 127.0.0.1:27017.
MONGODB_URI=mongodb://127.0.0.1:27017/?directConnection=true
MONGODB_DB=billing
# Libera o simulador com ENVIRONMENT=production (so demonstracao).
SIMULADOR_PERMITIDO=false
# Processo prazos: arquivo de heartbeat (healthcheck) e porta do /metrics.
PRAZOS_HEARTBEAT=/tmp/prazos-heartbeat
METRICS_PORT=8000
# entrypoint.sh da imagem: seed da tabela de precos no boot da API.
RUN_SEED_ON_STARTUP=false

# --- So do compose: portas no host (127.0.0.1) e nome da imagem -----------
API_PORT=8002
MONGO_PORT=27017
BILLING_IMAGE=pytstop-billing:dev
